{
  "datasets": [
    {
      "name": "skills",
      "displayName": "Top 15 skills",
      "queryLines": [
        "SELECT skill_name, job_count, avg_salary_usd, salary_sample_count, salary_coverage FROM ${catalog}.${prefix}_gold.mart_skill_demand ORDER BY job_count DESC, skill_name LIMIT 15"
      ]
    },
    {
      "name": "cities",
      "displayName": "Observed posting dates",
      "queryLines": [
        "SELECT posted_date, city_name, job_count FROM ${catalog}.${prefix}_gold.mart_daily_city_jobs ORDER BY posted_date, city_name"
      ]
    }
  ],
  "pages": [
    {
      "name": "market",
      "displayName": "Vietnam IT jobs",
      "layout": [
        {
          "widget": {
            "name": "description",
            "multilineTextboxSpec": {
              "lines": [
                "## Vietnam IT Job Market\n\n",
                "Source: public ITviec postings. Demand counts postings present in the latest complete snapshot. ",
                "Salary is the mean advertised monthly midpoint; NULL indicates insufficient salary data. ",
                "The publication-date chart includes only observed postings; a posting may belong to multiple cities.\n\n",
                "[Rates By Exchange Rate API](https://www.exchangerate-api.com)"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "demand",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "skills",
                  "fields": [
                    {
                      "name": "skill_name",
                      "expression": "`skill_name`"
                    },
                    {
                      "name": "job_count",
                      "expression": "`job_count`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "skill_name",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "job_count",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Top 15 skills by posting count"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 3,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "trend",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "cities",
                  "fields": [
                    {
                      "name": "posted_date",
                      "expression": "`posted_date`"
                    },
                    {
                      "name": "job_count",
                      "expression": "`job_count`"
                    },
                    {
                      "name": "city_name",
                      "expression": "`city_name`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "posted_date",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fieldName": "job_count",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "color": {
                  "fieldName": "city_name",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Observed postings by publication date and city"
              }
            }
          },
          "position": {
            "x": 3,
            "y": 3,
            "width": 3,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "salary",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "skills",
                  "fields": [
                    {
                      "name": "skill_name",
                      "expression": "`skill_name`"
                    },
                    {
                      "name": "avg_salary_usd",
                      "expression": "`avg_salary_usd`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "skill_name",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "avg_salary_usd",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Mean advertised salary (USD/month, both bounds required)"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 9,
            "width": 3,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "coverage",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "skills",
                  "fields": [
                    {
                      "name": "skill_name",
                      "expression": "`skill_name`"
                    },
                    {
                      "name": "salary_coverage",
                      "expression": "`salary_coverage`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "skill_name",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "salary_coverage",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Salary midpoint coverage (0–1)"
              }
            }
          },
          "position": {
            "x": 3,
            "y": 9,
            "width": 3,
            "height": 6
          }
        }
      ]
    }
  ]
}
