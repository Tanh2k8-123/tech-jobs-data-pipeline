{
  "datasets": [
    {
      "name": "role_summary",
      "displayName": "Role Summary",
      "queryLines": [
        "with latest as (\n",
        "    select max(snapshot_date) as snapshot_date\n",
        "    from ${catalog}.${prefix}_gold.fct_job_daily_snapshots\n",
        "), eligible_tags as (\n",
        "    select b.snapshot_sk, b.skill_sk\n",
        "    from ${catalog}.${prefix}_gold.bridge_job_snapshot_skills b\n",
        "    inner join ${catalog}.${prefix}_gold.dim_skills d on b.skill_sk = d.skill_sk\n",
        "    left join ${catalog}.${prefix}_silver.role_tag_labels r on lower(d.skill_name) = r.skill_name\n",
        "    where r.skill_name is null\n",
        ")\n",
        "select :role_family as selected_role,\n",
        "    count(distinct f.job_sk) as posting_count,\n",
        "    count(distinct f.company_sk) as company_count,\n",
        "    count(distinct t.skill_sk) as skill_count,\n",
        "    (select snapshot_date from latest) as snapshot_date,\n",
        "    (select max(collected_at) from ${catalog}.${prefix}_gold.fct_job_daily_snapshots\n",
        "     where snapshot_date = (select snapshot_date from latest)) as data_collected_at,\n",
        "    (select count(distinct snapshot_date)\n",
        "     from ${catalog}.${prefix}_gold.fct_job_daily_snapshots) as collected_days,\n",
        "    count(distinct case when f.role_classification = 'unclassified' then f.job_sk end)\n",
        "        as unclassified_posts,\n",
        "    count(distinct case when f.role_classification = 'multiple_primary_matches' then f.job_sk end)\n",
        "        as multiple_role_titles\n",
        "from ${catalog}.${prefix}_gold.fct_job_daily_snapshots f\n",
        "inner join latest l on f.snapshot_date = l.snapshot_date\n",
        "left join eligible_tags t on f.snapshot_sk = t.snapshot_sk\n",
        "where :role_family = 'All roles' or f.role_family = :role_family\n"
      ],
      "parameters": [
        {
          "keyword": "role_family",
          "displayName": "Role family",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All roles"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "role_trend",
      "displayName": "Role Trend",
      "queryLines": [
        "with top_roles as (\n",
        "    select role_family, sum(posting_count) as latest_count\n",
        "    from ${catalog}.${prefix}_gold.mart_daily_role_demand\n",
        "    where snapshot_date = (\n",
        "        select max(snapshot_date) from ${catalog}.${prefix}_gold.mart_daily_role_demand\n",
        "    ) and role_family <> 'Other'\n",
        "    group by role_family\n",
        "    having sum(posting_count) > 0\n",
        "    order by latest_count desc, role_family limit 6\n",
        ")\n",
        "select snapshot_date, role_family, sum(posting_count) as posting_count\n",
        "from ${catalog}.${prefix}_gold.mart_daily_role_demand\n",
        "where (:role_family = 'All roles' and role_family in (select role_family from top_roles))\n",
        "    or role_family = :role_family\n",
        "group by snapshot_date, role_family\n",
        "order by snapshot_date, role_family\n"
      ],
      "parameters": [
        {
          "keyword": "role_family",
          "displayName": "Role family",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All roles"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "role_skills",
      "displayName": "Role Skills",
      "queryLines": [
        "with total as (\n",
        "    select sum(posting_count) as role_posting_count\n",
        "    from ${catalog}.${prefix}_gold.mart_daily_role_demand\n",
        "    where snapshot_date = (select max(snapshot_date)\n",
        "        from ${catalog}.${prefix}_gold.mart_daily_role_demand)\n",
        "        and (:role_family = 'All roles' or role_family = :role_family)\n",
        ")\n",
        "select s.skill_name, sum(s.posting_count) as posting_count,\n",
        "    max(t.role_posting_count) as role_posting_count,\n",
        "    round(100.0 * sum(s.posting_count) / max(t.role_posting_count), 1) as skill_share_pct\n",
        "from ${catalog}.${prefix}_gold.mart_daily_role_skills s cross join total t\n",
        "where s.snapshot_date = (select max(snapshot_date)\n",
        "    from ${catalog}.${prefix}_gold.mart_daily_role_demand)\n",
        "    and (:role_family = 'All roles' or s.role_family = :role_family)\n",
        "group by s.skill_name\n",
        "order by posting_count desc, s.skill_name\n",
        "limit 15\n"
      ],
      "parameters": [
        {
          "keyword": "role_family",
          "displayName": "Role family",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All roles"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "skill_trend",
      "displayName": "Skill Trend",
      "queryLines": [
        "with role_counts as (\n",
        "    select snapshot_date, sum(posting_count) as role_posting_count\n",
        "    from ${catalog}.${prefix}_gold.mart_daily_role_demand\n",
        "    where :role_family = 'All roles' or role_family = :role_family\n",
        "    group by snapshot_date\n",
        "), skill_counts as (\n",
        "    select snapshot_date, skill_name, sum(posting_count) as posting_count\n",
        "    from ${catalog}.${prefix}_gold.mart_daily_role_skills\n",
        "    where :role_family = 'All roles' or role_family = :role_family\n",
        "    group by snapshot_date, skill_name\n",
        "), top_skills as (\n",
        "    select skill_name, posting_count from skill_counts\n",
        "    where snapshot_date = (select max(snapshot_date) from role_counts)\n",
        "    order by posting_count desc, skill_name limit 5\n",
        ")\n",
        "select r.snapshot_date, t.skill_name,\n",
        "    coalesce(s.posting_count, 0) as posting_count, r.role_posting_count,\n",
        "    case when r.role_posting_count > 0 then\n",
        "        round(100.0 * coalesce(s.posting_count, 0) / r.role_posting_count, 1)\n",
        "    end as skill_share_pct\n",
        "from role_counts r cross join top_skills t\n",
        "left join skill_counts s on r.snapshot_date = s.snapshot_date and t.skill_name = s.skill_name\n",
        "order by r.snapshot_date, t.skill_name\n"
      ],
      "parameters": [
        {
          "keyword": "role_family",
          "displayName": "Role family",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All roles"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "role_skill_details",
      "displayName": "Role Skill Details",
      "queryLines": [
        "with totals as (\n",
        "    select role_family, sum(posting_count) as role_posting_count\n",
        "    from ${catalog}.${prefix}_gold.mart_daily_role_demand\n",
        "    where snapshot_date = (select max(snapshot_date)\n",
        "        from ${catalog}.${prefix}_gold.mart_daily_role_demand)\n",
        "        and (:role_family = 'All roles' or role_family = :role_family)\n",
        "    group by role_family\n",
        "), counts as (\n",
        "    select role_family, skill_name, sum(posting_count) as posting_count\n",
        "    from ${catalog}.${prefix}_gold.mart_daily_role_skills\n",
        "    where snapshot_date = (select max(snapshot_date)\n",
        "        from ${catalog}.${prefix}_gold.mart_daily_role_demand)\n",
        "        and (:role_family = 'All roles' or role_family = :role_family)\n",
        "    group by role_family, skill_name\n",
        "), ranked as (\n",
        "    select c.*, t.role_posting_count,\n",
        "        round(100.0 * c.posting_count / t.role_posting_count, 1) as skill_share_pct,\n",
        "        row_number() over (partition by c.role_family\n",
        "            order by c.posting_count desc, c.skill_name) as skill_rank\n",
        "    from counts c inner join totals t on c.role_family = t.role_family\n",
        ")\n",
        "select role_family, skill_name, posting_count, role_posting_count, skill_share_pct\n",
        "from ranked\n",
        "where skill_rank <= case when :role_family = 'All roles' then 3 else 15 end\n",
        "order by role_family, skill_rank\n"
      ],
      "parameters": [
        {
          "keyword": "role_family",
          "displayName": "Role family",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All roles"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "role_ranking",
      "displayName": "Role Ranking",
      "queryLines": [
        "select role_family, sum(posting_count) as posting_count\n",
        "from ${catalog}.${prefix}_gold.mart_daily_role_demand\n",
        "where snapshot_date = (\n",
        "    select max(snapshot_date) from ${catalog}.${prefix}_gold.mart_daily_role_demand\n",
        ")\n",
        "group by role_family\n",
        "having sum(posting_count) > 0\n",
        "order by posting_count desc, role_family\n",
        "limit 15\n"
      ]
    },
    {
      "name": "role_options",
      "displayName": "Observed roles",
      "queryLines": [
        "SELECT 'All roles' AS role_family UNION ",
        "SELECT DISTINCT role_family FROM ",
        "${catalog}.${prefix}_gold.mart_daily_role_demand ",
        "WHERE posting_count > 0 ORDER BY role_family"
      ]
    }
  ],
  "pages": [
    {
      "name": "market",
      "displayName": "Roles and skills",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "description",
            "multilineTextboxSpec": {
              "lines": [
                "## Vietnam IT Job Market: roles and skills\n\n",
                "Select a role for trends and skills; ranking shows all roles. ",
                "Each collected day uses its last complete batch.\n\n",
                "Skills are public tags, not full requirements. ",
                "Exact role-name tags are excluded. Labels use title rules; ",
                "Other and multi-role titles need review. ",
                "Short history is not a long-term trend. Source: ITviec. ",
                "[Rates By Exchange Rate API](https://www.exchangerate-api.com)"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "role_filter",
            "queries": [
              {
                "name": "role_choices",
                "query": {
                  "datasetName": "role_options",
                  "fields": [
